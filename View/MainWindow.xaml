<Window x:Class="ToDo_Manager.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ToDo_Manager.View"
        xmlns:vm="clr-namespace:ToDo_Manager.ViewModels"
        Title="ToDo Manager"
        Width="1450" Height="750"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- Анимация появления кнопки -->
        <Storyboard x:Key="SidebarButtonAppearAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.45"/>

            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="-40" To="0"
                             Duration="0:0:0.45"/>
        </Storyboard>

        <!-- Стиль кнопок боковой панели -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform X="-40"/>
                </Setter.Value>
            </Setter>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="12">
                            <ContentPresenter HorizontalAlignment="Left"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4CAF50"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="#2E2E2E" Grid.Column="0">
            <StackPanel Margin="20">

                <TextBlock Text="ToDo Manager"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,30"/>

                <!-- Кнопка 1  -->
                <Button Content="My tasks"
                        Command="{Binding NavigateTasksCommand}"
                        Style="{StaticResource SidebarButtonStyle}">
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1"
                                                     Duration="0:0:1"
                                                     BeginTime="0:0:0.20"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                     From="-40" To="0"
                                                     Duration="0:0:0.45"
                                                     BeginTime="0:0:0.00"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Button.Triggers>
                </Button>

                <!-- Кнопка 2 -->
                <Button Content="My tags"
                        Command="{Binding NavigateTagsCommand}"
                        Style="{StaticResource SidebarButtonStyle}">
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1"
                                                     Duration="0:0:2"
                                                     BeginTime="0:0:0.65"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                     From="-40" To="0"
                                                     Duration="0:0:0.45"
                                                     BeginTime="0:0:0.15"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Button.Triggers>
                </Button>
                <!-- Кнопка 3 -->
                <Button Content="Settings"
                        
                        Style="{StaticResource SidebarButtonStyle}">
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                      From="0" To="1"
                                      Duration="0:0:3"
                                      BeginTime="0:0:0.85"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                      From="-40" To="0"
                                      Duration="0:0:0.45"
                                      BeginTime="0:0:0.15"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Button.Triggers>
                </Button>

            </StackPanel>
        </Border>

        <!-- Content -->
        <Frame Grid.Column="1"
               NavigationUIVisibility="Hidden"
               Content="{Binding CurrentPage}"/>

    </Grid>
</Window>
